{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "redirects": [
    {
      "source": "/:section(ui|docs|registry)/:path*",
      "has": [{ "type": "host", "value": "w3-kit.com" }],
      "destination": "https://:section.w3-kit.com/:path*",
      "permanent": true
    },
    {
      "source": "/:section(ui|docs|registry)",
      "has": [{ "type": "host", "value": "w3-kit.com" }],
      "destination": "https://:section.w3-kit.com/",
      "permanent": true
    }
  ]
}
